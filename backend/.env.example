# profassist Environment Variables

# === Project ===
PROJECT_NAME=profassist
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=Asia/Dubai  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=profassist

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === RAG Configuration ===
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=recursive  # recursive, markdown, or fixed
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
RAG_ENABLE_OCR=false  # OCR fallback for scanned PDFs (requires tesseract-ocr installed)
# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# S3/MinIO (document ingestion)
S3_RAG_ENDPOINT=
S3_RAG_ACCESS_KEY=
S3_RAG_SECRET_KEY=
S3_RAG_BUCKET=profassist-rag
S3_RAG_REGION=us-east-1

# === Prefect ===
# Self-hosted (open-source): keep the default below.
# Prefect Cloud: set to your workspace URL and add PREFECT_API_KEY.
PREFECT_API_URL=http://localhost:4200/api
# PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxx   # required for Cloud only

# === S3/MinIO Storage ===
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=profassist
S3_REGION=us-east-1


# === ProfAssist ===
# Leave both keys empty to run the built-in demo drafter (no network call).
# Set either key to use a live model through LiteLLM.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (LiteLLM). Example: http://localhost:4000/v1
LLM_BASE_URL=
# Optional three models for the grading council, comma-separated.
# LLM_COUNCIL_MODELS=gpt-4o-mini,gpt-4o-mini,gpt-4o-mini
MOODLE_MODE=fake
# MOODLE_BASE_URL=https://moodle.example.edu
# MOODLE_WS_TOKEN=
# Langfuse tracing is off unless both the key and the flag are set.
LANGFUSE_ENABLED=false
# MLflow tracking UI is http://localhost:5000 inside Compose.
MLFLOW_TRACKING_URI=http://localhost:5000
# Docling is optional and off. It needs the docling package installed.
DOCLING_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001
DEMO_PROFESSOR_EMAIL=professor@demo.uowd.ac.ae
DEMO_PROFESSOR_PASSWORD=ProfAssist-demo-1
PROFASSIST_AUTO_SEED=true

# === AI Agent (langgraph, openai) ===
OPENAI_API_KEY=
AI_MODEL=gpt-5.5
AI_TEMPERATURE=0.7
# Embeddings
# OpenAI Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Retrieval
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10

# Reranker

# PDF Parser

# Google Drive (optional, for document ingestion)

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
REDIS_PASSWORD=change-me-in-production
