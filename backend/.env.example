# profassist Environment Variables

# === Project ===
PROJECT_NAME=profassist
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=Asia/Dubai  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=profassist

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === RAG Configuration ===
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=recursive  # recursive, markdown, or fixed
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
RAG_ENABLE_OCR=false  # OCR fallback for scanned PDFs (requires tesseract-ocr installed)
# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# S3/MinIO (document ingestion)
S3_RAG_ENDPOINT=
S3_RAG_ACCESS_KEY=
S3_RAG_SECRET_KEY=
S3_RAG_BUCKET=profassist-rag
S3_RAG_REGION=us-east-1

# === Prefect ===
# Self-hosted (open-source): keep the default below.
# Prefect Cloud: set to your workspace URL and add PREFECT_API_KEY.
PREFECT_API_URL=http://localhost:4200/api
# PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxx   # required for Cloud only

# === S3/MinIO Storage ===
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=profassist
S3_REGION=us-east-1


# === ProfAssist ===
# Set a key to use a live model through LiteLLM.
# With no key, drafting fails with an explicit error; nothing is fabricated.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (LiteLLM). Example: http://localhost:4000/v1
LLM_BASE_URL=
# Optional write-only Mem0 mirror. Off by default; Postgres is the source of truth.
MEM0_ENABLED=false
# Optional three models for the grading council, comma-separated.
# LLM_COUNCIL_MODELS=gpt-4o-mini,gpt-4o-mini,gpt-4o-mini
MOODLE_MODE=real
# MOODLE_BASE_URL=https://moodle.example.edu
# MOODLE_WS_TOKEN=
# MOODLE_ALLOW_PRIVATE=false  # dev only: allow http://localhost
# MOODLE_PUSH_ENABLED=false
# Langfuse UI is http://localhost:3100
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-profassist-local
LANGFUSE_SECRET_KEY=sk-lf-profassist-local-secret
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_BASE_URL=http://localhost:3100
LANGFUSE_PROJECT_ID=profassist-project
# MLflow tracking UI is http://localhost:5000 inside Compose.
MLFLOW_TRACKING_URI=http://localhost:5000

# === Plagiarism worker (optional, external) ===
# Passage-reuse scoring is not vendored. Point these at a separate worker
# that owns the model and threshold. Leave the URL blank to keep the status
# "not_installed". Never enable fake scores when the worker is absent.
# PLAGIARISM_WORKER_URL=https://worker.example
PLAGIARISM_WORKER_URL=
# Optional bearer token. The admin page only reports set/hidden.
PLAGIARISM_WORKER_TOKEN=
# Docling is optional and off. It needs the docling package installed.
DOCLING_ENABLED=false

# === AI Agent (langgraph, openai) ===
OPENAI_API_KEY=
AI_MODEL=gpt-5.5
AI_TEMPERATURE=0.7

# === Embeddings ===
# local = fastembed on CPU (default, no API key). The model downloads once
# into MODELS_CACHE_DIR on first use. Supported local models:
#   BAAI/bge-small-en-v1.5 (384), BAAI/bge-base-en-v1.5 (768),
#   BAAI/bge-large-en-v1.5 (1024), sentence-transformers/all-MiniLM-L6-v2 (384)
# A remote model name (e.g. text-embedding-3-small, gemini-embedding-001) with
# EMBEDDING_PROVIDER=local falls back to BAAI/bge-small-en-v1.5 with a warning.
# openai/remote = hosted embeddings; set EMBEDDING_API_KEY (or OPENAI_API_KEY)
# and keep the hosted model name here (e.g. text-embedding-3-small).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_API_KEY=
# Optional OpenAI-compatible endpoint for remote embeddings
# EMBEDDING_BASE_URL=
# 0 = derive the vector size from EMBEDDING_MODEL (bge-small = 384,
# text-embedding-3-small = 1536, text-embedding-3-large = 3072)
EMBEDDING_DIM=0

# Reranker

# PDF Parser

# Google Drive (optional, for document ingestion)

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
REDIS_PASSWORD=change-me-in-production
