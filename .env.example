# ProfAssist POC - copy this file to .env and set one key.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key. The professor adds their own key
# once, locally; nothing in the repository contains a live credential.

# === Model (one Gemini key is enough) ===
# Used by drafting, the AI agent, and Mem0. Leave LLM_API_KEY blank to reuse it.
GEMINI_API_KEY=
AI_MODEL=gemini/gemini-3.5-flash-lite
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=
# Optional OpenAI-compatible gateway, e.g. http://localhost:4000/v1
LLM_BASE_URL=

# === Private model worker (optional; enabled with Compose profile `mlops`) ===
# Set paths to the checked-out integration/profassist-workers source tree.
PROFASSIST_MLOPS_SOURCE=../student-dropout-mlops
PROFASSIST_MINILM_MODEL_DIR=../student-dropout-mlops/models/minilm
PROFASSIST_WORKER_TOKEN=
PROFASSIST_WORKER_TIMEOUT_SECONDS=300
PLAGIARISM_WORKER_URL=http://profassist-worker:8081
# Required for plagiarism until an assignment-scoped release is active.
# Use the concrete registered name and version of a worker-verified seed.
PASSAGE_REUSE_MODEL_NAME=
PASSAGE_REUSE_MODEL_VERSION=

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=profassist

# === Mem0 (optional mirror, enabled by compose) ===
MEM0_ENABLED=true
MEM0_EMBEDDER_PROVIDER=fastembed
MEM0_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
MEM0_EMBEDDER_DIMS=384
MEM0_HISTORY_PATH=/app/data/mem0.db
MEM0_TELEMETRY=False
LITELLM_DROP_PARAMS=True

# === Langfuse (bundled local stack) ===
# These are local project placeholders created by docker-compose.yml, not secrets.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-profassist-local
LANGFUSE_SECRET_KEY=sk-lf-profassist-local-secret
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_BASE_URL=http://localhost:3100
LANGFUSE_PROJECT_ID=profassist-project

# === Moodle (bundled mock simulator) ===
MOODLE_MODE=real
MOODLE_BASE_URL=http://moodle-mock:8090
MOODLE_WS_TOKEN=demo-token
MOODLE_ALLOW_PRIVATE=true
MOODLE_PUSH_ENABLED=false

# === Bootstrap ===
# Optional: promote this email to app-admin at startup. The first registration
# already becomes app-admin, so this can stay blank.
FIRST_ADMIN_EMAIL=
